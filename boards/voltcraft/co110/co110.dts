/dts-v1/;
#include <st/l4/stm32l431Xc.dtsi>
#include <st/l4/stm32l431r(b-c)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	model = "Voltcraft CO-110 CO2 monitor";
	compatible = "voltcraft,co110";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	aliases {
		led0 = &led_green;
	};

	/* LEDs are active low (anode to 3V3) */
	/* dimmable LEDs: software PWM driver (src/led_swpwm.c), Zephyr LED API */
	leds: leds {
		compatible = "voltcraft,swpwm-leds";
		led_power: led_power {	/* LD1, green */
			gpios = <&gpiob 15 GPIO_ACTIVE_LOW>;
		};
		led_red: led_red {	/* LD2 */
			gpios = <&gpiob 14 GPIO_ACTIVE_LOW>;
		};
		led_yellow: led_yellow {	/* LD3 */
			gpios = <&gpiob 13 GPIO_ACTIVE_LOW>;
		};
		led_green: led_green {	/* LD4 */
			gpios = <&gpiob 12 GPIO_ACTIVE_LOW>;
		};
	};

	/* active buzzer: Zephyr buzzer API */
	buzzer: buzzer {
		compatible = "gpio-buzzer";
		gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>;
	};

	zephyr,user {
		/* HT1625-style LCD controller, bit-banged */
		lcd-cs-gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>;	/* active low on the wire, driven raw */
		lcd-wr-gpios = <&gpioc 8 GPIO_ACTIVE_HIGH>;
		lcd-data-gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>;
		lcd-rd-gpios = <&gpioc 9 GPIO_ACTIVE_HIGH>;

		backlight-gpios = <&gpioc 3 GPIO_ACTIVE_HIGH>;
		buzzer-gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>;
		sensor-power-gpios = <&gpioc 2 GPIO_ACTIVE_HIGH>;	/* CM1106S supply */
		aux-pc13-gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;	/* set high by the original firmware, purpose unknown */
		aux-pa2-gpios = <&gpioa 2 GPIO_ACTIVE_HIGH>;	/* driven low after boot, purpose unknown */

		/* touch controller outputs, active low */
		up-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;
		down-gpios = <&gpioa 5 GPIO_ACTIVE_LOW>;
		menu-gpios = <&gpioa 6 GPIO_ACTIVE_LOW>;
		enter-gpios = <&gpioa 7 GPIO_ACTIVE_LOW>;
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* last 32 KB (16 pages of 2 KB): settings and trend logs (NVS) */
		storage_partition: partition@38000 {
			label = "storage";
			reg = <0x00038000 DT_SIZE_K(32)>;
		};
	};
};

&clk_lsi {
	status = "okay";
};

/* MSI range 10 = 32 MHz, no PLL (as in the original firmware) */
&clk_msi {
	status = "okay";
	msi-range = <10>;
};

&rcc {
	clocks = <&clk_msi>;
	clock-frequency = <DT_FREQ_M(32)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

&gpioa { status = "okay"; };
&gpiob { status = "okay"; };
&gpioc { status = "okay"; };

/* CM1106S CO2 sensor, 9600 8N1 */
&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <9600>;
	status = "okay";
};

/* SHT30 temperature/humidity sensor at 0x44 */
&i2c2 {
	pinctrl-0 = <&i2c2_scl_pb10 &i2c2_sda_pb11>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";

	sht30: sht3xd@44 {
		compatible = "sensirion,sht3xd";
		reg = <0x44>;
	};
};
